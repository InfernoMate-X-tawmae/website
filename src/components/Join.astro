---
import ArrowUpRight from '~icons/lucide/arrow-up-right';
import Crown from '~icons/lucide/crown';
import MonitorPlay from '~icons/lucide/monitor-play';
import Discord from '~icons/simple-icons/discord';
import { site } from '../data/site';

const rows = [
  { title: 'Discord', text: 'Kommt in die Gruppe! Porsche Cayman S!', href: site.discord, icon: Discord },
  { title: 'EhrenMates', text: 'Für ein paar lausige Dublonen könnt ihr heftige Ehrenmates werden. Ihr supportet nicht nur mich, sondern kriegt auch kranke P2W-Vorteile', href: site.shop, icon: Crown },
  { title: 'Stream Widgets', text: 'Checkt mal meine krassen Widgets aus, viel geiler als die von nutty oder tawmae', href: site.shop, icon: MonitorPlay },
];
---

<section class="mx-auto max-w-[76rem] px-4 py-20 sm:px-6 sm:py-28" aria-labelledby="mehr">
  <h2 id="mehr" class="display text-6xl sm:text-7xl">Mehr</h2>
  <ul class="mt-8 border-t border-white/15">
    {rows.map((r) => (
      <li>
        <a
          href={r.href}
          rel="noopener"
          class="group grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1.5 border-b border-white/10 py-6 transition-colors hover:bg-white/[0.025] sm:grid-cols-[3rem_21rem_minmax(0,1fr)_auto] sm:gap-x-6 sm:py-8"
        >
          <r.icon class="size-7 text-ember-light sm:size-8" aria-hidden="true" />
          <span class="display text-4xl transition-colors group-hover:text-ember-light sm:text-5xl">{r.title}</span>
          <span class="col-start-2 row-start-2 text-sm text-white/60 sm:col-start-3 sm:row-start-1 sm:text-base">{r.text}</span>
          <ArrowUpRight class="col-start-3 row-span-2 row-start-1 size-7 text-white/60 transition duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-paper sm:col-start-4 sm:row-span-1" aria-hidden="true" />
        </a>
      </li>
    ))}
  </ul>
</section>
