---
import Avatar from './Avatar.astro';
import { fmt, url } from '../lib/format';
import type { LoyaltyData } from '../data/types';

interface Props {
  loyalty: LoyaltyData;
}

const { loyalty } = Astro.props;
const p = loyalty.pointsName;

const tabs: { key: keyof LoyaltyData['leaderboards']; label: string; caption: string }[] = [
  { key: 'current', label: 'Kontostand', caption: `Wer gerade die meisten ${p} hat.` },
  { key: 'week', label: 'Woche', caption: `Diese Woche verdiente ${p}.` },
  { key: 'month', label: 'Monat', caption: `Diesen Monat verdiente ${p}.` },
];
---

<section class="reveal mx-auto mt-20 max-w-[76rem] px-4 sm:mt-24 sm:px-6" style="--i:3" aria-labelledby="rangliste">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
    <h2 id="rangliste" class="display text-6xl sm:text-7xl">Rangliste</h2>
    <div role="tablist" aria-label="Zeitraum" class="flex gap-6 text-sm font-bold sm:text-base" data-tabs>
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.key}`}
          aria-controls={`panel-${t.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="cursor-pointer border-b-[3px] border-transparent pb-1.5 text-white/50 transition-colors hover:text-paper aria-selected:border-ember aria-selected:text-paper"
        >
          {t.label}
        </button>
      ))}
    </div>
  </div>

  {tabs.map((t, i) => {
    const rows = loyalty.leaderboards[t.key];
    const max = rows[0]?.points || 1;
    return (
      <div role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} hidden={i !== 0}>
        <p class="mt-3 text-sm text-white/50">{t.caption}</p>
        {rows.length === 0 && <p class="mt-5 border-y border-white/15 py-8 text-white/55">Noch keine Einträge.</p>}

        <ol class="mt-5 grid border-y border-white/15 md:grid-cols-3">
          {rows.slice(0, 3).map((r) => (
            <li class:list={['relative flex items-center gap-4 border-white/10 py-5 md:block md:px-7 md:py-7', r.rank === 1 ? 'md:pl-0' : 'border-t md:border-l md:border-t-0']}>
              {r.rank === 1 && <span class="absolute inset-x-0 -top-px h-1 bg-ember md:right-7" aria-hidden="true"></span>}
              <div class="flex shrink-0 items-start justify-between md:w-full">
                <Avatar src={r.avatar} name={r.name} size={88} class={['size-16 text-2xl md:size-[5.5rem] md:text-3xl', r.rank === 1 && 'ring-[3px] ring-ember'].filter(Boolean).join(' ')} />
                <span class:list={['display num hidden text-8xl md:block', r.rank === 1 ? 'text-ember' : 'text-white/20']} aria-hidden="true">{r.rank}</span>
              </div>
              <div class="min-w-0 flex-1">
                <p class="truncate text-lg font-bold md:mt-5 md:text-xl">
                  <span class="mr-1 text-white/45 md:sr-only">{r.rank}.</span><a href={url(`spieler/?name=${encodeURIComponent(r.login)}`)} class="transition-colors hover:text-ember-light">{r.name}</a>
                </p>
                <p class="mt-1 flex items-baseline gap-2">
                  <span class="display num text-4xl md:text-5xl">{fmt(r.points)}</span>
                  <span class="text-sm text-white/50">{p}</span>
                </p>
              </div>
            </li>
          ))}
        </ol>

        <ol class="mt-2" start="4">
          {rows.slice(3).map((r, j) => (
            <li class="grid grid-cols-[2.25rem_2.25rem_minmax(0,1fr)_auto] items-center gap-x-3 border-b border-white/10 py-2.5 sm:grid-cols-[3rem_2.25rem_minmax(0,13rem)_minmax(0,1fr)_auto] sm:gap-x-5">
              <span class="display num text-2xl text-white/40">{r.rank}</span>
              <Avatar src={r.avatar} name={r.name} size={36} class="size-9 text-sm" />
              <a href={url(`spieler/?name=${encodeURIComponent(r.login)}`)} class="truncate font-semibold transition-colors hover:text-ember-light">{r.name}</a>
              <span class="hidden h-2 bg-white/[0.06] sm:block" aria-hidden="true">
                <span class="bar block h-full bg-ember" style={`width:${Math.max(3, (r.points / max) * 100)}%;--i:${j}`}></span>
              </span>
              <span class="num text-right font-bold">{fmt(r.points)}</span>
            </li>
          ))}
        </ol>
      </div>
    );
  })}
</section>

<script>
  for (const list of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  }
</script>
