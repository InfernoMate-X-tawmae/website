---
import flame from '../assets/brand/flame.webp';
import Twitch from '~icons/simple-icons/twitch';
import Discord from '~icons/simple-icons/discord';
import SocialIcon from './SocialIcon.astro';
import Avatar from './Avatar.astro';
import { site, socials } from '../data/site';
import { fmt, fmtStamp } from '../lib/format';
import type { LoyaltyData } from '../data/types';

interface Props {
  loyalty: LoyaltyData;
}

const { loyalty } = Astro.props;
const week = loyalty.leaderboards.week[0];
const leader = week ?? loyalty.leaderboards.current[0];
const leaderLabel = week ? 'Bester Earner diese Woche' : 'Gerade auf Platz 1';
const leaderUnit = week ? `${loyalty.pointsName} verdient` : loyalty.pointsName;
const listed = socials.filter((s) => s.id !== 'twitch' && s.id !== 'discord');
---

<section class="mx-auto max-w-[76rem] px-4 pt-10 sm:px-6 sm:pt-14">
  <h1 class="display reveal flex items-center gap-[0.06em] whitespace-nowrap text-[clamp(2.9rem,15.6vw,12.9rem)] leading-[0.78]">
    <img src={flame.src} alt="" width="320" height="320" class="-ml-[0.04em] h-[0.92em] w-auto" />
    <span>Inferno<span class="text-ember">Mate</span></span>
  </h1>

  <div class="mt-8 grid gap-10 border-b border-white/15 pb-10 sm:mt-10 lg:grid-cols-12 lg:gap-12">
    <div class="reveal lg:col-span-7" style="--i:1">
      <p class="max-w-[46ch] text-lg leading-relaxed text-white/80">
        Stats, Leaderboards und mehr aus dem Stream, um zu zeigen, wer der größte Gamba-Addict ist.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={site.twitch} rel="noopener" class="inline-flex items-center gap-2 rounded-md bg-ember px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-ember-light">
          <Twitch class="size-4" aria-hidden="true" /> Zum Stream
        </a>
        <a href={site.discord} rel="noopener" class="inline-flex items-center gap-2 rounded-md border border-white/20 px-5 py-3 text-sm font-bold transition-colors hover:border-white/50">
          <Discord class="size-4" aria-hidden="true" /> Discord
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold" aria-label="Weitere Socials">
        {listed.map((s) => (
          <li>
            <a href={s.href} rel="noopener" class="inline-flex items-center gap-1.5 text-white/60 transition-colors hover:text-paper">
              <SocialIcon id={s.id} class="size-3.5" /> {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal lg:col-span-5 lg:border-l lg:border-white/10 lg:pl-12" style="--i:2">
      {leader && (
        <>
          <p class="mb-3 text-sm text-white/55">{leaderLabel}</p>
          <div class="mb-5 flex items-center gap-4">
            <Avatar src={leader.avatar} name={leader.name} size={72} lazy={false} class="size-[4.5rem] text-2xl ring-[3px] ring-ember" />
            <div class="min-w-0">
              <p class="truncate text-xl font-bold">{leader.name}</p>
              <p class="mt-1 flex items-baseline gap-2">
                <span class="display num text-5xl">{fmt(leader.points)}</span>
                <span class="text-sm text-white/55">{leaderUnit}</span>
              </p>
            </div>
          </div>
        </>
      )}
      <p class="text-sm text-white/50">Stand {fmtStamp(loyalty.updatedAt)}</p>
    </div>
  </div>
</section>
