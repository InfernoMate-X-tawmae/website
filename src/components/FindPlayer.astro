---
import PlayerSearch from './PlayerSearch.astro';
---

<section class="bg-ember" aria-labelledby="spieler-suchen">
  <div class="mx-auto grid max-w-[76rem] items-end gap-8 px-4 py-14 sm:px-6 sm:py-16 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 id="spieler-suchen" class="display text-6xl text-white sm:text-7xl">Deine Stats</h2>
      <p class="mt-3 font-medium text-white">Nicht im Leaderboard? Well, get good! Aber du kannst deine Stats trotzdem abrufen. Oder die von irgendwem anders...</p>
    </div>
    <PlayerSearch id="home-search" class="lg:col-span-7" />
  </div>
</section>
