---
interface Props {
  fill: string;
  edge?: string;
  class?: string;
}

const { fill, edge = '#f3f0ec', class: className } = Astro.props;
---

<svg viewBox="0 0 48 48" class={className} aria-hidden="true">
  <circle cx="24" cy="24" r="23" fill={fill} />
  {[0, 60, 120, 180, 240, 300].map((deg) => (
    <rect x="20.5" y="1" width="7" height="7.5" rx="1" fill={edge} transform={`rotate(${deg} 24 24)`} />
  ))}
  <circle cx="24" cy="24" r="15" fill="none" stroke={edge} stroke-opacity="0.75" stroke-width="1.4" stroke-dasharray="3.2 2.6" />
  <circle cx="24" cy="24" r="11.5" fill={fill} />
  <circle cx="24" cy="24" r="11.5" fill="#000" fill-opacity="0.18" />
</svg>
