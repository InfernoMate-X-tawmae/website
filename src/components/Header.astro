---
import flame from '../assets/brand/flame.webp';
import ArrowUpRight from '~icons/lucide/arrow-up-right';
import Menu from '~icons/lucide/menu';
import X from '~icons/lucide/x';
import { site } from '../data/site';
import { url } from '../lib/format';

const nav = [
  { label: 'Rangliste', href: url('#rangliste') },
  { label: 'Spieler', href: url('spieler/') },
  { label: 'Commands', href: url('commands/') },
  { label: 'Casino', href: url('#casino') },
  { label: 'Chat-Spiele', href: url('#chat-spiele') },
  { label: 'Twitch', href: url('#twitch') },
  { label: 'Community', href: url('#community') },
  { label: 'Mehr', href: url('#mehr') },
];
---

<header class="relative border-b border-white/10">
  <div class="mx-auto flex h-14 max-w-[76rem] items-center gap-5 px-4 sm:gap-8 sm:px-6">
    <a href={url()} class="shrink-0" aria-label="InfernoMate, Startseite">
      <img src={flame.src} alt="" width="28" height="28" class="size-7" />
    </a>
    <nav class="hidden min-w-0 gap-5 text-sm font-semibold text-white/60 lg:flex xl:gap-7" aria-label="Hauptmenü">
      {nav.map((item) => <a href={item.href} class="shrink-0 py-1 transition-colors hover:text-paper">{item.label}</a>)}
      <a href={site.shop} rel="noopener" class="inline-flex shrink-0 items-center gap-0.5 py-1 transition-colors hover:text-paper">
        Shop <ArrowUpRight class="size-3.5" aria-hidden="true" />
      </a>
    </nav>
    <a href={site.twitch} rel="noopener" class="ml-auto shrink-0 rounded-md bg-ember px-3.5 py-2 text-sm font-bold text-white transition-colors hover:bg-ember-light">
      Twitch
    </a>
    <button id="menu-button" type="button" aria-expanded="false" aria-controls="menu" class="group -mr-2 flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-md transition-colors hover:bg-white/5 lg:hidden">
      <span class="sr-only">Menü</span>
      <Menu class="size-6 group-aria-expanded:hidden" aria-hidden="true" />
      <X class="hidden size-6 group-aria-expanded:block" aria-hidden="true" />
    </button>
  </div>

  <nav id="menu" hidden class="absolute inset-x-0 top-full z-30 max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-b border-white/10 bg-ground px-4 pb-4 shadow-[0_16px_40px_rgba(0,0,0,0.5)] sm:px-6 lg:hidden" aria-label="Hauptmenü">
    {nav.map((item) => <a href={item.href} class="block border-b border-white/10 py-3.5 font-semibold transition-colors hover:text-ember-light">{item.label}</a>)}
    <a href={site.shop} rel="noopener" class="flex items-center gap-1 py-3.5 font-semibold transition-colors hover:text-ember-light">
      Shop <ArrowUpRight class="size-4" aria-hidden="true" />
    </a>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-button')!;
  const menu = document.getElementById('menu')!;
  const toggle = (open: boolean) => {
    button.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
  };

  button.addEventListener('click', () => toggle(menu.hidden));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) toggle(false);
  });
  document.addEventListener('click', (e) => {
    if (!menu.hidden && !(e.target as HTMLElement).closest('#menu, #menu-button')) toggle(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || menu.hidden) return;
    toggle(false);
    button.focus();
  });
</script>
