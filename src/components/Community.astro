---
import type { ComponentProps } from 'astro/types';
import MiniBoard from './MiniBoard.astro';
import { fmt, fmtTime, pct } from '../lib/format';
import type { CommunityData } from '../data/types';

interface Props {
  community: CommunityData;
}

const { community } = Astro.props;
const { watchtime, lurks, songs } = community;
const per = (a: number, b: number) => (b > 0 ? Math.round(a / b) : 0);

const panels: {
  key: string;
  name: string;
  count: string;
  countLabel: string;
  rows: [string, string][];
  topLabel: string;
  top: ComponentProps<typeof MiniBoard>['rows'];
  topValue: (v: number) => string;
}[] = [
  {
    key: 'watchtime',
    name: 'Watchtime',
    count: fmt(Math.floor(watchtime.seconds / 3600)),
    countLabel: 'Stunden zugeschaut (seit März 2025)',
    rows: [
      ['Zuschauer', fmt(watchtime.viewers)],
      ['Im Schnitt pro Zuschauer', fmtTime(per(watchtime.seconds, watchtime.viewers))],
    ],
    topLabel: 'Längste Watchtime',
    top: watchtime.top,
    topValue: fmtTime,
  },
  {
    key: 'lurks',
    name: 'Lurks',
    count: fmt(lurks.count),
    countLabel: 'Lurks',
    rows: [
      ['Lurker', fmt(lurks.lurkers)],
      ['Gelurkt insgesamt', fmtTime(lurks.seconds)],
    ],
    topLabel: 'Am längsten gelurkt',
    top: lurks.top,
    topValue: fmtTime,
  },
  {
    key: 'songs',
    name: 'Song Requests',
    count: fmt(songs.requests),
    countLabel: 'Requests',
    rows: [
      ['Leute mit Requests', fmt(songs.requesters)],
      ['Im Schnitt pro Person', fmt(per(songs.requests, songs.requesters))],
    ],
    topLabel: 'Meiste Requests',
    top: songs.top,
    topValue: (v) => `${fmt(v)} ${v === 1 ? 'Request' : 'Requests'}`,
  },
  {
    key: 'top-songs',
    name: 'Top-Songs',
    count: fmt(songs.different),
    countLabel: 'verschiedene Songs',
    rows: [
      ['Häufigster Song', songs.topSongs[0] ? `${fmt(songs.topSongs[0].value)}×` : '–'],
      ['Anteil an allen Requests', songs.topSongs[0] ? `${pct(songs.topSongs[0].value, songs.requests)} %` : '–'],
    ],
    topLabel: 'Am häufigsten gewünscht',
    top: songs.topSongs.map((s) => ({ login: null, name: s.name, note: s.artists, avatar: null, value: s.value })),
    topValue: (v) => `${fmt(v)}×`,
  },
];
---

<section class="mx-auto max-w-[76rem] px-4 py-20 sm:px-6 sm:py-28" aria-labelledby="community">
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
    <h2 id="community" class="display text-6xl sm:text-7xl">Community</h2>
    <p class="text-white/60">Watchtime, Lurks und Song Requests</p>
  </div>

  <div class="mt-10 grid grid-cols-1 border-t border-white/15 lg:grid-cols-2">
    {panels.map((g, i) => (
      <article class:list={['flex min-w-0 flex-col border-white/10 py-9 lg:row-span-2 lg:grid lg:grid-rows-subgrid', i > 0 && 'border-t', i === 1 && 'lg:border-t-0', i % 2 === 0 ? 'lg:border-r lg:pr-12' : 'lg:pl-12']}>
        <div>
          <h3 class="display text-5xl">{g.name}</h3>

          <p class="mt-5 flex items-baseline gap-2.5">
            <span class="display num text-7xl">{g.count}</span>
            <span class="text-white/55">{g.countLabel}</span>
          </p>

          <dl class="mt-5 text-sm">
            {g.rows.map(([label, value]) => (
              <div class="flex justify-between gap-4 border-t border-white/[0.08] py-2">
                <dt class="text-white/55">{label}</dt>
                <dd class="num text-right font-semibold">{value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="min-w-0 pt-6">
          <MiniBoard id={`top-${g.key}`} label={g.topLabel} rows={g.top} value={g.topValue} />
        </div>
      </article>
    ))}
  </div>
</section>
