---
interface Props {
  src: string | null;
  name: string;
  size: number;
  class?: string;
  lazy?: boolean;
}

const { src, name, size, class: className, lazy = true } = Astro.props;
---

{src ? (
  <img src={src} alt="" width={size} height={size} loading={lazy ? 'lazy' : 'eager'} class:list={['rounded-full object-cover', className]} />
) : (
  <span class:list={['flex items-center justify-center rounded-full bg-white/10 font-bold text-white/70', className]} aria-hidden="true">
    {name.slice(0, 1).toUpperCase()}
  </span>
)}
