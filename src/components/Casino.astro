---
import PlayingCard from './PlayingCard.astro';
import PokerChip from './PokerChip.astro';
import MiniBoard from './MiniBoard.astro';
import { fmt, fmtCompact, fmtNet, pct } from '../lib/format';
import type { CasinoData, CommunityData, TopRow } from '../data/types';

interface Props {
  casino: CasinoData;
  slots: CommunityData['slots'];
  pointsName: string;
}

const { casino, slots, pointsName } = Astro.props;
const { roulette, blackjack, poker } = casino;

const RED = new Set([1, 3, 5, 7, 9, 12, 14, 16, 18, 19, 21, 23, 25, 27, 30, 32, 34, 36]);
const pocket = (n: number) => (n === 0 ? 'bg-roulette-green' : RED.has(n) ? 'bg-roulette-red' : 'bg-roulette-black ring-1 ring-inset ring-white/15');
const wagered = (n: number) => `${fmtCompact(n)} ${pointsName}`;
const payout = (paid: number, staked: number) => `${pct(paid, staked)} %`;

const tables: {
  name: string;
  command: string;
  count: number;
  countLabel: string;
  rows: [string, string][];
  top: TopRow[];
  artifact: 'roulette' | 'blackjack' | 'poker' | 'slots';
}[] = [
  {
    name: 'Roulette',
    command: '!setzen',
    count: roulette.rounds,
    countLabel: 'Runden gedreht',
    rows: [
      ['Eingesetzt', wagered(roulette.wagered)],
      ['Zurückgezahlt', payout(roulette.paidOut, roulette.wagered)],
    ],
    top: roulette.top,
    artifact: 'roulette',
  },
  {
    name: 'Blackjack',
    command: '!bj',
    count: blackjack.hands,
    countLabel: 'Hände gespielt',
    rows: [
      ['Gewonnen', `${pct(blackjack.won, blackjack.hands)} % der Hände`],
      ['Eingesetzt', wagered(blackjack.wagered)],
      ['Zurückgezahlt', payout(blackjack.paidOut, blackjack.wagered)],
    ],
    top: blackjack.top,
    artifact: 'blackjack',
  },
  {
    name: 'Poker',
    command: '!poker',
    count: poker.hands,
    countLabel: 'Hände gespielt',
    rows: [
      ['Eingesetzt', wagered(poker.wagered)],
      ['Zurückgezahlt', payout(poker.paidOut, poker.wagered)],
    ],
    top: poker.top,
    artifact: 'poker',
  },
  {
    name: 'Slot Machine',
    command: '!slots',
    count: slots.spins,
    countLabel: 'Spins',
    rows: [
      ['Gewonnen', `${pct(slots.wins, slots.spins)} % der Spins`],
      ['Eingesetzt', wagered(slots.wagered)],
      ['Zurückgezahlt', payout(slots.paidOut, slots.wagered)],
    ],
    top: slots.top,
    artifact: 'slots',
  },
];

const pokerWon = pct(poker.won, poker.hands);
---

<section class="mt-24 border-y border-white/[0.06] bg-raised sm:mt-32" aria-labelledby="casino">
  <div class="mx-auto max-w-[76rem] px-4 py-16 sm:px-6 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <h2 id="casino" class="display text-6xl sm:text-7xl">Casino</h2>
      <p class="text-white/60">Alle Stats für's Casino</p>
    </div>

    <div class="mt-10 grid grid-cols-1 border-t border-white/15 lg:grid-cols-2">
      {tables.map((t, i) => (
        <article class:list={['flex min-w-0 flex-col border-white/10 py-8 lg:row-span-2 lg:grid lg:grid-rows-subgrid', i > 0 && 'border-t', i === 1 && 'lg:border-t-0', i % 2 === 0 ? 'lg:border-r lg:pr-12' : 'lg:pl-12']}>
          <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="display text-4xl">{t.name}</h3>
            <code class="font-mono text-xs text-white/55">{t.command}</code>
          </div>

          <div class="mt-5 flex h-14 items-center">
            {t.artifact === 'roulette' && (
              <ol class="grid w-full grid-cols-10 gap-1" aria-label="Letzte Roulette-Zahlen, neueste links">
                {roulette.lastNumbers.slice(0, 10).map((n) => (
                  <li class:list={['num flex aspect-square items-center justify-center rounded-[3px] text-sm font-bold text-white', pocket(n)]}>{n}</li>
                ))}
              </ol>
            )}
            {t.artifact === 'blackjack' && (
              <div class="flex items-center gap-4">
                <div class="flex" aria-hidden="true">
                  <PlayingCard rank="A" suit="♠" />
                  <PlayingCard rank="K" suit="♥" class="-ml-3" />
                </div>
                <p class="flex items-baseline gap-2">
                  <span class="display num text-4xl">{fmt(blackjack.blackjacks)}×</span>
                  <span class="text-sm text-white/55">Blackjack</span>
                </p>
              </div>
            )}
            {t.artifact === 'slots' && (
              <div class="flex items-center gap-4">
                <div class="flex gap-1" aria-hidden="true">
                  {['7', '7', '7'].map((s) => <span class="display flex h-12 w-9 items-center justify-center rounded-[3px] bg-paper pt-1 text-3xl text-roulette-red">{s}</span>)}
                </div>
                <p class="flex flex-wrap items-baseline gap-x-2">
                  <span class="display num text-4xl">{fmt(slots.biggestWin)}</span>
                  <span class="text-sm text-white/55">höchster Gewinn</span>
                </p>
              </div>
            )}
            {t.artifact === 'poker' && (
              <div class="flex w-full items-center gap-4">
                <div class="flex shrink-0" aria-hidden="true">
                  <PokerChip fill="#d84613" class="size-12 drop-shadow-[0_2px_0_rgba(0,0,0,0.35)]" />
                  <PokerChip fill="#141419" class="-ml-5 size-12 drop-shadow-[0_2px_0_rgba(0,0,0,0.35)]" />
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex h-2.5 overflow-hidden rounded-[2px] bg-white/10" role="img" aria-label={`Der Chat gewinnt ${pokerWon} % der Hände, die Bank ${100 - pokerWon} %`}>
                    <span class="block h-full bg-ember" style={`width:${pokerWon}%`}></span>
                  </div>
                  <p class="mt-1.5 flex justify-between gap-2 text-xs">
                    <span><span class="font-bold">{pokerWon} %</span> <span class="text-white/55">Chat</span></span>
                    <span><span class="font-bold">{100 - pokerWon} %</span> <span class="text-white/55">Bank</span></span>
                  </p>
                </div>
              </div>
            )}
          </div>

          <p class="mt-6 flex items-baseline gap-2.5">
            <span class="display num text-6xl">{fmt(t.count)}</span>
            <span class="text-sm text-white/55">{t.countLabel}</span>
          </p>

          <dl class="mt-4 text-sm">
            {t.rows.map(([label, value]) => (
              <div class="flex justify-between gap-4 border-t border-white/[0.08] py-2">
                <dt class="text-white/55">{label}</dt>
                <dd class="num text-right font-semibold">{value}</dd>
              </div>
            ))}
          </dl>
          </div>

          <div class="mt-5 border-t border-white/[0.08] pt-4">
            <MiniBoard id={`top-${t.artifact}`} label="Top-Verdiener" rows={t.top} value={fmtNet} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
