---
import Search from '~icons/lucide/search';

interface Props {
  id: string;
  mode?: 'go' | 'event';
  tone?: 'ground' | 'raised';
  class?: string;
}

const { id, mode = 'go', tone = 'ground', class: className } = Astro.props;
const bg = tone === 'ground' ? 'bg-ground' : 'bg-raised';
---

<div class:list={['relative', className]} data-player-search data-mode={mode}>
  <label for={`${id}-input`} class="sr-only">Spieler suchen</label>
  <Search class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-white/50" aria-hidden="true" />
  <input
    id={`${id}-input`}
    type="search"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls={`${id}-list`}
    autocomplete="off"
    spellcheck="false"
    placeholder="Twitch-Name eingeben"
    class:list={['h-14 w-full rounded-md border border-white/10 pl-12 pr-4 text-lg font-semibold text-paper placeholder:font-medium placeholder:text-white/40 focus:border-white/40 focus:outline-none', bg]}
  />
  <ul id={`${id}-list`} role="listbox" hidden class:list={['absolute inset-x-0 top-full z-20 mt-1 max-h-96 overflow-auto rounded-md border border-white/10 py-1 text-paper shadow-[0_16px_40px_rgba(0,0,0,0.5)]', bg]}></ul>
</div>

<script>
  import { attachSearch, playerUrl } from '../scripts/players';

  for (const box of document.querySelectorAll<HTMLElement>('[data-player-search]')) {
    if (box.dataset.bound) continue;
    box.dataset.bound = '1';
    attachSearch(box, (p) => {
      if (box.dataset.mode === 'go') location.href = playerUrl(p.login);
      else box.dispatchEvent(new CustomEvent('player-pick', { detail: p, bubbles: true }));
    });
  }
</script>
