---
import Search from '~icons/lucide/search';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadData } from '../lib/data';
import { fmtStamp } from '../lib/format';
import type { CommandEntry, CommandsData } from '../data/types';

const data = await loadData<CommandsData>('commands.json');

const sorted = [...data.commands].sort((a, b) => Number(!a.group) - Number(!b.group));
const groups = new Map<string, CommandEntry[]>();
for (const c of sorted) groups.set(c.group || 'Sonstige', [...(groups.get(c.group || 'Sonstige') ?? []), c]);

// "[LOYALTY POINTS] Duell" -> "Duell", wenn die Kennung schon in der Gruppe steht
const open = data.commands.filter((c) => !c.mod).length;
const label = (c: CommandEntry) => c.name.replace(/^\[([^\]]*)\][\s-]*(?=\S)/, (prefix, tag) => (c.group.includes(tag) ? '' : prefix));
---

<Base title="Commands · InfernoMate" description="Alle Chat-Commands aus dem Stream von InfernoMate.">
  <Header />
  <main class="mx-auto max-w-[76rem] px-4 pb-24 pt-10 sm:px-6 sm:pt-16">
    <div class="reveal grid items-end gap-6 border-b border-white/15 pb-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <h1 class="display text-7xl sm:text-8xl">Commands</h1>
        <p class="mt-3 text-white/60">Stand {fmtStamp(data.updatedAt)}</p>
      </div>
      <p class="text-white/60 lg:col-span-7"><span id="command-count" class="num font-bold text-paper" aria-live="polite">{open}</span> Commands</p>
    </div>

    <div class="sticky top-0 z-10 -mx-4 flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-white/10 bg-ground px-4 py-4 sm:-mx-6 sm:px-6">
      <div class="relative min-w-0 flex-1 basis-64">
        <label for="command-search" class="sr-only">Command suchen</label>
        <Search class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-white/50" aria-hidden="true" />
        <input
          id="command-search"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Command suchen"
          class="h-14 w-full rounded-md border border-white/10 bg-raised pl-12 pr-4 text-lg font-semibold text-paper placeholder:font-medium placeholder:text-white/40 focus:border-white/40 focus:outline-none"
        />
      </div>
      <button id="mod-switch" type="button" role="switch" aria-checked="false" class="group flex shrink-0 cursor-pointer items-center gap-3 py-2 text-sm font-bold text-white/60 transition-colors hover:text-paper aria-checked:text-paper">
        <span class="flex h-6 w-11 items-center rounded-full bg-white/15 p-0.5 transition-colors group-aria-checked:bg-ember" aria-hidden="true">
          <span class="size-5 rounded-full bg-paper transition-transform group-aria-checked:translate-x-5"></span>
        </span>
        Mod-Commands
      </button>
    </div>

    {[...groups].map(([group, commands]) => (
      <section class="mt-14" data-group hidden={commands.every((c) => c.mod)}>
        <h2 class="display text-5xl">{group}</h2>
        <ul class="mt-5 border-t border-white/15">
          {commands.map((c) => (
            <li
              class="grid gap-x-8 gap-y-2 border-b border-white/10 py-3 sm:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] sm:items-center"
              data-command={[group, c.name, ...c.triggers].join('\n').toLowerCase()}
              data-mod={c.mod ? '' : undefined}
              hidden={c.mod}
            >
              <span class="font-semibold">
                {label(c)}
                {c.mod && <span class="ml-2 rounded-[3px] bg-ember px-1.5 py-0.5 text-xs font-bold text-white">Mod</span>}
              </span>
              <span class="flex flex-wrap gap-2">
                {c.triggers.map((t) => (
                  <code class="rounded-md border border-white/15 bg-raised px-2.5 py-1 font-mono text-sm text-ember-light [overflow-wrap:anywhere]">{t}</code>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p id="command-empty" class="mt-12 text-lg text-white/70" hidden={open > 0}>Keine Commands gefunden.</p>
  </main>
  <Footer />
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('#command-search')!;
  const empty = document.getElementById('command-empty')!;
  const count = document.getElementById('command-count')!;
  const mods = document.getElementById('mod-switch')!;
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];

  function update() {
    const term = input.value.trim().toLowerCase();
    const showMods = mods.getAttribute('aria-checked') === 'true';
    let shown = 0;
    for (const group of groups) {
      const items = [...group.querySelectorAll<HTMLElement>('[data-command]')];
      for (const item of items) {
        item.hidden = !item.dataset.command!.includes(term) || ('mod' in item.dataset && !showMods);
        if (!item.hidden) shown++;
      }
      group.hidden = items.every((item) => item.hidden);
    }
    count.textContent = String(shown);
    empty.hidden = shown > 0;
  }

  function setMods(on: boolean) {
    mods.setAttribute('aria-checked', String(on));
    try {
      localStorage.setItem('mod-commands', on ? '1' : '0');
    } catch {}
    update();
  }

  input.addEventListener('input', update);
  mods.addEventListener('click', () => setMods(mods.getAttribute('aria-checked') !== 'true'));
  try {
    mods.setAttribute('aria-checked', String(localStorage.getItem('mod-commands') === '1'));
  } catch {}
  update();
</script>
