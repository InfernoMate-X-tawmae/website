---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Masthead from '../components/Masthead.astro';
import TwitchLive from '../components/TwitchLive.astro';
import Leaderboard from '../components/Leaderboard.astro';
import Casino from '../components/Casino.astro';
import ChatGames from '../components/ChatGames.astro';
import Community from '../components/Community.astro';
import FindPlayer from '../components/FindPlayer.astro';
import TwitchStats from '../components/TwitchStats.astro';
import Join from '../components/Join.astro';
import Footer from '../components/Footer.astro';
import { loadData } from '../lib/data';
import type { CasinoData, CommunityData, GamesData, LoyaltyData, TwitchData } from '../data/types';

const loyalty = await loadData<LoyaltyData>('loyalty.json');
const casino = await loadData<CasinoData>('casino.json');
const games = await loadData<GamesData>('games.json');
const twitch = await loadData<TwitchData>('twitch.json');
const community = await loadData<CommunityData>('community.json');
---

<Base>
  <Header />
  <main>
    <Masthead loyalty={loyalty} />
    <TwitchLive />
    <Leaderboard loyalty={loyalty} />
    <Casino casino={casino} slots={community.slots} pointsName={loyalty.pointsName} />
    <ChatGames games={games} quiz={community.quiz} pointsName={loyalty.pointsName} />
    <TwitchStats twitch={twitch} />
    <Community community={community} />
    <FindPlayer />
    <Join />
  </main>
  <Footer />
</Base>
